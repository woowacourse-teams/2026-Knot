                "to": 0
              },
              "datasourceUid": "knot-prometheus",
              "model": {
                "refId": "A",
                "expr": "100 * (1 - avg by (env, instance) (rate(node_cpu_seconds_total{mode=\"idle\",env=~\"dev|prod\"}[5m])))",
