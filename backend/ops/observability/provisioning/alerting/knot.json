        {
          "uid": "knot-dev-5xx",
          "title": "Knot DEV API 5xx high",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "knot-loki",
              "model": {
                "refId": "A",
                "expr": "100 * (sum by (env) (rate({project=\"knot\",job=\"nginx\",env=\"dev\"} | json | uri !~ \"/health|/actuator/.*\" | status =~ \"5..\" | __error__=\"\" [5m])) or on(env) (0 * sum by (env) (rate({project=\"knot\",job=\"nginx\",env=\"dev\"} | json | uri !~ \"/health|/actuator/.*\" | __error__=\"\" [5m])))) / (sum by (env) (rate({project=\"knot\",job=\"nginx\",env=\"dev\"} | json | uri !~ \"/health|/actuator/.*\" | __error__=\"\" [5m])) > 0) and on(env) (sum by (env) (count_over_time({project=\"knot\",job=\"nginx\",env=\"dev\"} | json | uri !~ \"/health|/actuator/.*\" | __error__=\"\" [5m])) >= 20)",
                "instant": true,
                "range": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "datasource": {
                  "type": "loki",
                  "uid": "knot-loki"
                },
                "queryType": "instant"
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "conditions": [
