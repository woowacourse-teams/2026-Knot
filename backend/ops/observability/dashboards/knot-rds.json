{
  "title": "05 RDS",
  "uid": "knot-rds",
  "schemaVersion": 41,
  "version": 5,
  "tags": [
    "knot",
    "operations"
  ],
  "refresh": "30s",
  "timezone": "Asia/Seoul",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "환경",
        "type": "custom",
        "query": "dev,prod",
        "multi": true,
        "includeAll": true,
        "allValue": "dev|prod",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": [
          {
            "text": "dev",
            "value": "dev",
            "selected": false
          },
          {
            "text": "prod",
            "value": "prod",
            "selected": false
          }
        ]
      },
      {
        "name": "db",
        "label": "DB",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "knot-prometheus"
        },
        "definition": "label_values(aws_rds_cpuutilization_average{env=~\"$env\"}, dimension_DBInstanceIdentifier)",
        "query": {
          "query": "label_values(aws_rds_cpuutilization_average{env=~\"$env\"}, dimension_DBInstanceIdentifier)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "적용 범위",
      "options": {
        "mode": "markdown",
        "content": "Dev: `knot-dev-database`, Prod: `knot-database`의 실제 CloudWatch 지표입니다. 기존 EC2 역할과 Alloy를 사용하며 AWS 키는 저장하지 않습니다.\n\n5분 집계·조회, 최근 10분 검색이므로 실시간 DB 순간값이 아닙니다. 데이터가 없으면 정상 0으로 표시하지 않습니다. Hikari 풀과 함께 확인하고, 서로 다른 앱의 성능 우열로 해석하지 않습니다."
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "id": 1
    },
    {
      "id": 2,
      "title": "RDS CPU 사용률",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "knot-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "noValue": "데이터 없음"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "CloudWatch 5분 Average. 호스트 메모리나 Hikari 연결 수가 아니라 RDS 자체 값입니다.",
      "targets": [
        {
          "refId": "A",
          "expr": "aws_rds_cpuutilization_average{env=~\"$env\",dimension_DBInstanceIdentifier=~\"$db\"} < +Inf",
          "legendFormat": "{{env}} {{dimension_DBInstanceIdentifier}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "RDS DB connections",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "knot-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "noValue": "데이터 없음"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "CloudWatch 5분 Average. 호스트 메모리나 Hikari 연결 수가 아니라 RDS 자체 값입니다.",
      "targets": [
        {
          "refId": "A",
          "expr": "aws_rds_database_connections_average{env=~\"$env\",dimension_DBInstanceIdentifier=~\"$db\"} < +Inf",
          "legendFormat": "{{env}} {{dimension_DBInstanceIdentifier}}"
        }
      ]
