      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{env=~\"$env\",instance=~\"$instance\"}/node_memory_MemTotal_bytes{env=~\"$env\",instance=~\"$instance\"})",
          "legendFormat": "{{env}} {{instance}}"
        }
