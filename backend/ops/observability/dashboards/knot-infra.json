{
  "title": "04 Infrastructure",
  "uid": "knot-infra",
  "schemaVersion": 41,
  "version": 5,
  "tags": [
    "knot",
    "operations"
  ],
  "refresh": "30s",
  "timezone": "Asia/Seoul",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "환경",
        "type": "custom",
        "query": "dev,prod",
        "multi": true,
        "includeAll": true,
        "allValue": "dev|prod",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": [
          {
            "text": "dev",
            "value": "dev",
            "selected": false
          },
          {
            "text": "prod",
            "value": "prod",
            "selected": false
          }
        ]
      },
      {
        "name": "instance",
        "label": "수집 대상 (Prometheus)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "knot-prometheus"
        },
        "query": "label_values({env=~\"$env\"}, instance)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "적용 범위",
      "options": {
        "mode": "markdown",
        "content": "AWS Dev·Prod 호스트 지표입니다. 최근 수집 여부와 EC2의 running/stopped 전원 상태는 서로 다른 정보입니다.\n\n수집 대상 변수는 Prometheus 패널에만 적용됩니다. host·Spring·외부 probe의 instance 값은 서로 다릅니다. Loki 요청·로그는 환경으로만 선택합니다. 신규 API 집계는 health/prometheus를 제외하고, 요청 없는 구간의 지연·비율은 계산하지 않습니다. RDS는 각 환경의 EC2 역할로 CloudWatch 5분 평균을 수집합니다. RDS 상세 화면은 DB 식별자로 선택합니다."
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "id": 1
    },
    {
      "id": 2,
      "title": "CPU 사용률",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "knot-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg by (env, instance) (rate(node_cpu_seconds_total{mode=\"idle\",env=~\"$env\",instance=~\"$instance\"}[2m])))",
          "legendFormat": "{{env}} {{instance}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "메모리 사용률",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "knot-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
