    {
      "id": 5,
      "title": "호스트 지표 수집 상태",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "knot-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "noValue": "수집 없음",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "장애",
                  "color": "red"
                },
                "1": {
                  "text": "수집 중",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (env) (present_over_time(node_cpu_seconds_total{env=~\"$env\",instance=~\"$instance\"}[2m]))",
          "legendFormat": "{{env}} {{instance}}",
          "instant": true,
          "range": false
        }
      ],
      "description": "최근 2분 내 호스트 CPU 지표 수집 여부입니다. 데이터가 없으면 서버·수집기·네트워크를 확인하세요. EC2 running/stopped 상태와는 다릅니다."
    },
