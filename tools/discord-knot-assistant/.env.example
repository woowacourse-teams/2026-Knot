# Copy this to .env and set the n8n production webhook URL.
N8N_NOTION_WEBHOOK_URL=

# Required shared header secret; configure the same value in the n8n Webhook node.
N8N_WEBHOOK_SECRET=

# Defaults are the Knot Discord server and Knot Notion root already selected for this bot.
DISCORD_GUILD_ID=1536954284447633448
NOTION_ROOT_PAGE_ID=3aeb4351752280a29797de8949496356
MAX_CONTEXT_CHARS=12000
CODEX_MODEL=gpt-5.6-luna
