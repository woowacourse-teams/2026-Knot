{
  "include": [
    "./**/*.ts",
    "./**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ],
  "compilerOptions": {
    "target": "es6",
    "module": "esnext",
    "strict": true,
    "skipLibCheck": false,
    "moduleResolution": "bundler",
    "jsx": "react",
    "esModuleInterop": true,
    "noEmit": true
  }
}